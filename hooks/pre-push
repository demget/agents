#!/bin/sh
# Before every push: refuse rewritten, unrelated or merged history, then scan every outgoing commit.
set -u
remote=$1 zero=0000000000000000000000000000000000000000 status=0
while read -r _ lsha _ rsha; do
  [ "$lsha" != "$zero" ] || continue
  if [ "$rsha" = "$zero" ]; then
    git merge-base "$lsha" "refs/remotes/$remote/main" >/dev/null 2>&1 || { echo "pre-push: $lsha shares no history with $remote/main; never bring other history into this public repository" >&2; exit 1; }
    range="$lsha --not --remotes=$remote"
  else
    git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null || { echo "pre-push: not a fast-forward of $rsha; never rewrite public history (fetch first if the remote moved)" >&2; exit 1; }
    range="$rsha..$lsha"
  fi
  # shellcheck disable=SC2086 # range is SHAs and options without spaces
  [ -z "$(git rev-list --merges $range)" ] || { echo "pre-push: outgoing merge commits; this repository keeps a linear history" >&2; exit 1; }
  "$(dirname "$0")/privacy-scan" commits $range </dev/null || status=1
done
exit $status
